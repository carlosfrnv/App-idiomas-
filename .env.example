# Nombre visible de la aplicación (configurable)
VITE_APP_NAME="estudivo.com"

# --- Fase 3 (plataforma online, opcional) ---
# URL pública del proyecto Supabase y clave ANON (pública, protegida por RLS).
# NUNCA pongas aquí la service_role key: no debe llegar al frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Asistente de letras con IA (servidor; NO usar prefijo VITE_) ---
# Basta con UNA de las dos. Si están ambas, se usa Groq y Gemini como respaldo.
# Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# LYRICS_PROVIDER=groq
